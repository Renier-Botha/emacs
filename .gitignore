# Everything Emacs/no-littering generates at runtime lives here.
/var/
/etc/
/elpa/
/eln-cache/
/auto-save-list/
/.cache/

# Compiled tree-sitter grammars (treesit-install-language-grammar's
# default install location). Machine-specific binaries, rebuilt on
# demand by treesit-auto; never meant to be committed.
/tree-sitter/

# Byte-compiled / native-compiled files anywhere in the tree.
*.elc
*.eln

# Backup / autosave / lock files, just in case something writes them
# outside of var/ (e.g. before no-littering kicks in).
*~
\#*\#
.\#*

# Local machine-specific overrides, not meant to be committed.
custom.el
local.el
